# =============================================================
# JAR-63 environment configuration
# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file. Never hardcode secrets.
# =============================================================

# --- Application ---
APP_NAME=JAR-63
APP_ENV=development          # development | testing | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG          # TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Database (PostgreSQL) ---
POSTGRES_USER=jar63
POSTGRES_PASSWORD=jar63
POSTGRES_DB=jar63
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jar63:jar63@postgres:5432/jar63
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- LLM (local-first, provider/model independent) ---
# JAR-63 is local-first: Ollama is the primary provider and NO API key is
# required to run the application. Cloud inference is optional.

# Master / routing
LLM_ENABLED=true
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=qwen2.5-coder:7b
LLM_ROUTING_POLICY=local_first      # local_first | local_only | cloud_first
LLM_REQUEST_TIMEOUT=60
LLM_VERBOSE_LOGGING=false           # dev-only: logs full prompts/completions
LLM_ALLOW_CLOUD_FOR_PRIVATE=false   # allow PRIVATE/SENSITIVE on cloud

# Ollama (primary, local) — install models manually with `ollama pull <model>`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Generic OpenAI-compatible provider (optional cloud)
# Works with any server exposing /v1/chat/completions. Leave disabled for
# local-only operation.
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Legacy optional provider keys (never required; retained for forward compat)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# --- Memory (Phase 6) ---
# JAR-63 memory is local-first: PostgreSQL is the durable source of truth,
# Redis handles working memory/cache, and vector storage is optional.
# No cloud embedding API or hosted vector database is required.
MEMORY_ENABLED=true
MEMORY_PG_PERSISTENCE=true
MEMORY_REDIS_WORKING=true
MEMORY_WORKING_TTL=3600
MEMORY_CACHE_TTL=600

# Vector memory (optional). "memory" = in-process (deterministic, for
# testing/dev). "pgvector" = requires the pgvector extension (see docs).
# Normal tests run without pgvector.
MEMORY_VECTOR_ENABLED=false
MEMORY_VECTOR_BACKEND=memory
MEMORY_VECTOR_DIMENSIONS=256

# Embedding provider (local-first). "hashing" = deterministic test provider
# (NOT real semantic quality). Future: a local Ollama embedding model.
MEMORY_EMBEDDING_PROVIDER=hashing
MEMORY_EMBEDDING_MODEL=

# Retrieval limits (context window control)
MEMORY_MAX_ITEMS=10
MEMORY_MAX_CHARS=4000
MEMORY_MAX_TOKENS=2000

# Retention (hours). PREFERENCE/SEMANTIC are long-lived (no expiry).
MEMORY_CONVERSATION_RETENTION_HOURS=48
MEMORY_TASK_RETENTION_HOURS=168

# Privacy: reject content matching these patterns unless explicitly allowed
MEMORY_SENSITIVE_PATTERNS=["api_key","password","token","bearer ","authorization"]
MEMORY_ALLOW_SENSITIVE=false

# Duplicate detection similarity threshold (0.0–1.0)
MEMORY_DUPLICATE_THRESHOLD=0.85
